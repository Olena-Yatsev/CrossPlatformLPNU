<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.demo.controller.WeatherAppController"
      prefHeight="600.0" prefWidth="1030.0" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f4f4f9;">
    <children>
        <!-- Left Panel -->
        <VBox spacing="20.0" style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 15; -fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, lightgray, 5, 0.2, 2, 2);">
            <children>
                <!-- Thread Pool Settings -->
                <GridPane prefWidth="300.0" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Set Thread Pool Sizes:" GridPane.columnSpan="2" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <Label text="Scheduled Thread Pool:" GridPane.rowIndex="1" style="-fx-font-size: 12;" />
                        <TextField fx:id="scheduledThreadPoolInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Fixed Thread Pool:" GridPane.rowIndex="2" style="-fx-font-size: 12;" />
                        <TextField fx:id="fixedThreadPoolInput" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Button fx:id="applyThreadSettingsButton" mnemonicParsing="false"
                                onAction="#handleApplyThreadSettingsButton" text="Apply"
                                GridPane.columnSpan="2" GridPane.rowIndex="3"
                                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                    </children>
                </GridPane>

                <!-- Add Weather Station -->
                <GridPane prefWidth="300.0" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Add Weather Station:" GridPane.columnSpan="2" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <Label text="Station Name:" GridPane.rowIndex="1" style="-fx-font-size: 12;" />
                        <TextField fx:id="stationNameInput" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Data Generation Period (sec):" GridPane.rowIndex="2" style="-fx-font-size: 12;" />
                        <TextField fx:id="stationDataGenerationPeriodInput" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Button fx:id="addStationButton" mnemonicParsing="false"
                                onAction="#handleAddStationButtonClick" text="Create Station"
                                GridPane.columnSpan="2" GridPane.rowIndex="3"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                    </children>
                </GridPane>
            </children>
        </VBox>

        <!-- Right Panel -->
        <VBox spacing="20.0" style="-fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 15; -fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, lightgray, 5, 0.2, 2, 2);" prefWidth="700.0">
            <children>
                <TableView fx:id="stationTable" prefHeight="400.0" prefWidth="650.0"
                           style="-fx-background-color: #ffffff; -fx-border-color: #dee2e6; -fx-border-radius: 5;" />
                <Button fx:id="deleteStationButton" mnemonicParsing="false"
                        onAction="#handleDeleteStationButton" text="Delete Station"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
                <GridPane>
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="500.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Aggregated Forecast:" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <Label fx:id="aggregatedForecastOutput" text="No data yet"
                               GridPane.columnIndex="1" style="-fx-font-size: 14; -fx-text-fill: #6c757d;" />
                    </children>
                </GridPane>
            </children>
        </VBox>
    </children>
</HBox>
